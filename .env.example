# Copy this file to .env and fill in values for local development.
# On Vercel, set these in Project Settings → Environment Variables.

SECRET_KEY=
FLASK_ENV=production

# Use Postgres on Vercel (SQLite does not persist on serverless).
# Example: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///freefire_tournament.db

SITE_NAME=Free Fire Tournaments
UPI_ID=8660267306@axl
UPI_NAME=VISMAY CM
# Optional: full URL to a hosted QR image. Leave empty to use /static/images/upi_qr.jpeg
UPI_QR_IMAGE=

# Admin login (created/updated on app start)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Supabase Storage: create private buckets named payment-screenshots and winner-images.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PAYMENT_BUCKET=payment-screenshots
SUPABASE_WINNERS_BUCKET=winner-images

MAX_CONTENT_LENGTH=10485760
